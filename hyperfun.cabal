cabal-version:      3.0
name:               hyperfun
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Liam Goodacre
maintainer:         goodacre.liam@gmail.com
-- copyright:
category:           Control
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable hyperfun
    import: warnings
    ghc-options: -O2
    main-is: Main.hs
    build-depends:
      base ^>=4.21.0.0,
      free,
      profunctors,
    hs-source-dirs:   app
    default-language: GHC2024
    default-extensions:
      BlockArguments,
      DerivingVia,
      LambdaCase,
